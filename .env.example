# Copiar a .env y cambiar TODOS los valores. El archivo .env NUNCA se sube a git.
# Reglas: minimo 12 caracteres, con mayusculas, minusculas, numeros y un simbolo.
# No usar comillas dobles, espacios ni el simbolo $.

# --- Oracle: SYS, SYSTEM y PDBADMIN (solo administracion de la instancia)
ORACLE_PWD=Cambiar_Clave_Sys_01

# --- Duenio del esquema "combustible" (01_usuario.sh)
COMBUSTIBLE_PWD=Cambiar_Clave_Esq_02

# --- Cuentas Oracle creadas por el script de seguridad
# u_dba: administrador operativo (no SYS)
DBA_PWD=Cambiar_Clave_Dba_03
# u_app: cuenta de servicio de la interfaz y el dashboard
APP_DB_PWD=Cambiar_Clave_App_04
# u_analista: solo lectura de vistas
ANALISTA_PWD=Cambiar_Clave_Ana_05
# u_auditor: lectura de auditoria
AUDITOR_PWD=Cambiar_Clave_Aud_06
# u_monitor: vistas de rendimiento V$
MONITOR_PWD=Cambiar_Clave_Mon_07
# u_backup: exportaciones Data Pump
BACKUP_PWD=Cambiar_Clave_Bkp_08
# u_estacion, u_fiscalizador y usuarios demo de la aplicacion
DEMO_PWD=Cambiar_Clave_Demo_09

# --- Aplicacion: clave inicial del usuario "admin" de la interfaz
ADMIN_APP_PWD=Cambiar_Clave_Admin_10
